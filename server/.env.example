# Local development; PostgreSQL is not required.
NODE_ENV=development
PORT=5000
STORAGE_MODE=json
# DATA_FILE defaults to server/data/db.json. Use an absolute path to override.
# UPLOADS_DIR defaults to server/data/uploads. Use persistent storage when hosting.
# First run prints a setup code locally; set your own strong token when hosting.
# After the administrator exists, remove SETUP_TOKEN or rotate it to an unused value.
# SETUP_TOKEN=replace-with-a-long-random-setup-code
# Hosted first-run alternative: create the first administrator from environment
# variables. ADMIN_EMAIL is the login username. Remove ADMIN_PASSWORD after the
# first successful deployment; existing users are never changed by these values.
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=replace-with-a-strong-password
# ADMIN_FULL_NAME=Administrator

# Later: set STORAGE_MODE=postgres and run npm run db:migrate, then db:import.
# DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_SERVICE:5432/jagtap_tours_crm
# DATABASE_URL takes precedence over PGHOST / PGPORT / PGUSER / PGPASSWORD / PGDATABASE.
# NODE_ENV=production
# TRUST_PROXY=1
# Production JSON requires explicit ALLOW_JSON_PRODUCTION=true and a persistent DATA_FILE volume.
