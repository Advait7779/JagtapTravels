# Copy to .env only for Docker Compose. Never commit the populated .env file.
# Generate POSTGRES_PASSWORD and ADMIN_PASSWORD with a password manager.
POSTGRES_PASSWORD=
# ADMIN_EMAIL is the administrator's login username. These values are used only
# when the database has no users. Remove ADMIN_PASSWORD after the first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator
# Optional alternative: leave ADMIN_* blank and use a 32+ character setup code.
SETUP_TOKEN=
SESSION_IDLE_MINUTES=10080
